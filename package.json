{
  "name": "status-monitor",
  "version": "0.3.0",
  "description": "Serverless uptime monitor and pager on Cloudflare Workers: tiered escalation, SMS-reply acknowledgement, signed deep health checks and a status page.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nclusive-scan/status-monitor.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p status-page/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:status-page": "node scripts/build-status-page.ts",
    "dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "dry-run:status-page": "npm run build:status-page && wrangler deploy --dry-run --config status-page/wrangler.jsonc --outdir \"$PWD/dist/status-page\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "lucide-react": "1.63.0",
    "motion": "14.7.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  }
}
